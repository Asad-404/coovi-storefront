# Storefront environment variables. Copy to .env.local for development; set the same names in Vercel for production.
# Both NEXT_PUBLIC_ values are inlined at build time, so set them BEFORE the build.

# Base URL of the Coovi API, including /api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Public address of this storefront (no trailing slash). Used for sitemap, robots, canonical links and share previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
