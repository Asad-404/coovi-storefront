# COOVI Storefront — production environment variables
# Copy to .env.production on the server and fill in real values. Never commit .env.production.
# Both NEXT_PUBLIC_ values are inlined at build time — set them before running docker compose build.

# Full URL of the API, including /api (no trailing slash).
NEXT_PUBLIC_API_URL=https://api.coovi.com/api

# Public address of this storefront (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://coovi.com

# WhatsApp number in international format, digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER=8801700000000

# Server-only secret. Must equal STOREFRONT_API_KEY in coovi-api/.env.production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STOREFRONT_API_KEY=CHANGE_ME
